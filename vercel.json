{
  "functions": {
    "api/download.js": {
      "maxDuration": 300,
      "includeFiles": ["bin/**", "node_modules/ffmpeg-static/**"]
    },
    "api/health.js": {
      "includeFiles": ["bin/**"]
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}